PROCEDURE "STONEMEN_USPGETCRFSEARCHDATA_Testing_1" (
  IN GUID NVARCHAR(50),
    IN BUYERNAME NVARCHAR(50),
    IN CRFREQNO INTEGER,
    IN CRFSTATUS NVARCHAR(100),
    IN CRFREQDATE NVARCHAR(15),
    IN REQTYP NVARCHAR(200),
    OUT 
  ReturnData TABLE (
    CRFREQGUID NVARCHAR(255),
    CRFREQNO INTEGER,
    REQTYP nvarchar(200),
      CREATEDBYUSERID_USERGUID NVARCHAR(255),
      USERNAME NVARCHAR(200),
      BUYERNAME NVARCHAR(255),
      BUYERCODE NVARCHAR(255),
      --USERNAME NVARCHAR(255),
      CRFSTATUS NVARCHAR(255),
      CRFREQDATE Nvarchar(200)
    )
  ) 
  LANGUAGE SQLSCRIPT 
  SQL SECURITY INVOKER 
  READS SQL DATA AS 
BEGIN
    DECLARE ActualBuyerCode NVARCHAR(200);
    DECLARE ActualCRFSTATUS NVARCHAR(200);
    DECLARE ActualCRFREQDATE NVARCHAR(200);
    DECLARE ActualREQTYP NVARCHAR(200);
    DECLARE CountSeekAdvice NVARCHAR(15);

    IF BUYERNAME = 'null' THEN ActualBuyerCode := NULL; ELSE ActualBuyerCode := BUYERNAME; END IF;
    IF CRFSTATUS = 'null' THEN ActualCRFSTATUS := NULL; ELSE ActualCRFSTATUS := CRFSTATUS; END IF;
    IF CRFREQDATE = 'null' THEN ActualCRFREQDATE :=null; ELSE ActualCRFREQDATE := CRFREQDATE; END IF;
    IF REQTYP = 'null' THEN ActualREQTYP :=null; ELSE ActualREQTYP := REQTYP; END IF;
    -- F CRFREQDATE = 'null' THEN  ActualCRFREQDATE :=null; ELSE ActualCRFREQDATE := CRFREQDATE; END IF;
    --IF Techno_Id = 'null' THEN ActualTechno_Id := NULL;  ELSE ActualTechno_Id := Techno_Id; END IF;

    A=(SELECT distinct T1."CRFREQGUID",T1."CRFREQNO",
    		CASE
    		WHEN T1."REQTYP" = 'N' then 'New' 
    		WHEN T1."REQTYP" = 'R' then 'Revision' else T1."REQTYP" END as "REQTYP",T1."CREATEDBYUSERID_USERGUID",T4."USERNAME",T1."BUYERNAME",T1."BUYERCODE",
			CASE 
			WHEN T1."CRFSTATUS" = 'N' THEN 'New' 
			WHEN T1."CRFSTATUS" = 'WIP' THEN 'Work-in-Progress'
			WHEN T1."CRFSTATUS" = 'CLS' THEN 'Closed' 
			WHEN T1."CRFSTATUS" = 'C' THEN 'Cancelled' 
			ELSE T1."CRFSTATUS"  END AS CRFSTATUS ,T1."CRFREQDATE"
            FROM "STONEMEN_DCRFHEADER" T1
            INNER JOIN "STONEMEN_DDATA" T2 ON T1."CRFREQGUID" = T2."OBJECTGUID"
            INNER JOIN "STONEMEN_CDATAFLOW" T3 ON T3."PARENT_DATAGUID" = T2."DATAGUID"
            LEFT JOIN "STONEMEN_CCRFSEEKADVICE" T5 ON T5."PARENT_CRFREQGUID" = T1."CRFREQGUID"
            LEFT JOIN "STONEMEN_MUSER" T4 ON T4."USERGUID" = T1."CREATEDBYUSERID_USERGUID"
            WHERE T3."USER_USERGUID" =:GUID or T5."QUESTIONFROMUSER_USERGUID"=:GUID);

    Returndata =select distinct A."CRFREQGUID",A."CRFREQNO",A."REQTYP",A."CREATEDBYUSERID_USERGUID",A."USERNAME",A."BUYERNAME",A."BUYERCODE",A."CRFSTATUS",A."CRFREQDATE" from :A AS A
    where (A."BUYERNAME" = :ActualBuyerCode OR (IFNULL(:ActualBuyerCode, '') = ''))
    AND (A."CRFREQNO" = :CRFREQNO OR (IFNULL(:CRFREQNO, 0) = 0))
    AND (A."CRFSTATUS" = :ActualCRFSTATUS OR (IFNULL(:ActualCRFSTATUS, '') = ''))
    AND (A."REQTYP" = :ActualREQTYP OR (IFNULL(:ActualREQTYP, '') = ''))
    AND ((:ActualCRFREQDATE IS NULL AND A."CRFREQDATE" <= CURRENT_DATE)
      OR (:ActualCRFREQDATE IS NULL AND A."CRFREQDATE" <= CURRENT_DATE)
      OR (A."CRFREQDATE" = :ActualCRFREQDATE))  ;
END;