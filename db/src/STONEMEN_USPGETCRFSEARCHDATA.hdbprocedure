PROCEDURE "STONEMEN_USPGETCRFSEARCHDATA" (
  IN GUID NVARCHAR(50),
  IN BUYERNAME NVARCHAR(50),
  IN CRFREQNO INTEGER,
  IN CRFSTATUS NVARCHAR(100),
  IN CRFREQDATE NVARCHAR(15),
  IN REQTYP NVARCHAR(200),
  OUT 
ReturnData TABLE (
    CRFREQGUID NVARCHAR(255),
    CRFREQNO INTEGER,
    REQTYP nvarchar(200),
    CREATEDBYUSERID_USERGUID NVARCHAR(255),
    USERNAME NVARCHAR(200),
    BUYERNAME NVARCHAR(255),
    BUYERCODE NVARCHAR(255),
    --USERNAME NVARCHAR(255),
    CRFSTATUS NVARCHAR(255),
    CRFREQDATE Nvarchar(200)
  )
) 
LANGUAGE SQLSCRIPT 
SQL SECURITY INVOKER 
READS SQL DATA AS 
BEGIN
DECLARE ActualBuyerCode NVARCHAR(200);
DECLARE ActualCRFSTATUS NVARCHAR(200);
DECLARE ActualCRFREQDATE NVARCHAR(200);
DECLARE ActualREQTYP NVARCHAR(200);
DECLARE CountSeekAdvice NVARCHAR(15);
/*use this varibles for get stage and role*/
DECLARE ROLECODE NVARCHAR(255);
DECLARE ROLEGUID NVARCHAR(255);
DECLARE COUNTOFADATA NVARCHAR(200);
DECLARE STAGEGUID NVARCHAR(200);
DECLARE lv_exists INT;

--end 
    IF BUYERNAME = 'null' THEN ActualBuyerCode := NULL;
    ELSE ActualBuyerCode := BUYERNAME;
    END IF;
    IF CRFSTATUS = 'null' THEN ActualCRFSTATUS := NULL;
    ELSE ActualCRFSTATUS := CRFSTATUS;
    END IF;
    IF CRFREQDATE = 'null' THEN ActualCRFREQDATE := NULL;
    ELSE ActualCRFREQDATE := CRFREQDATE;
    END IF;
    IF REQTYP = 'null' THEN ActualREQTYP := NULL;
    ELSE ActualREQTYP := REQTYP;
    END IF;
   --Get Role from Login User
    SELECT T1."ROLE_ROLEGUID" INTO  ROLEGUID FROM "STONEMEN_MUSER" T1 WHERE T1."USERGUID"=:GUID; 

    --Get stage from login user
    IF EXISTS (SELECT* FROM "STONEMEN_MROLE" T1 INNER JOIN "STONEMEN_CSTAGEROLE" T2 on T1."ROLEGUID" = T2."ROLE_ROLEGUID" WHERE T1."ROLEGUID" = :ROLEGUID)
    THEN

      SELECT top 1  T2."STAGE_STAGEGUID" INTO STAGEGUID FROM "STONEMEN_MROLE" T1 INNER JOIN "STONEMEN_CSTAGEROLE" T2 on T1."ROLEGUID" = T2."ROLE_ROLEGUID" WHERE T1."ROLEGUID" = :ROLEGUID;
      
      ELSE

        STAGEGUID = Null;

    END IF; 

    --Login user if exists in the CRF role data fatch 
    A =(SELECT DISTINCT T1."CRFREQGUID",T1."CRFREQNO",
    CASE
    WHEN T1."REQTYP" = 'N' THEN 'New'
    WHEN T1."REQTYP" = 'R' THEN 'Repeat'ELSE T1."REQTYP" END AS "REQTYP",
    T1."CREATEDBYUSERID_USERGUID",
    T4."USERNAME",
    T1."BUYERNAME",
    T1."BUYERCODE",
    CASE
    WHEN T1."CRFSTATUS" = 'N' THEN 'New'
    WHEN T1."CRFSTATUS" = 'WIP' THEN 'Work-in-Progress'
    WHEN T1."CRFSTATUS" = 'CLS' THEN REPLACE('Closed', '', '')
    WHEN T1."CRFSTATUS" = 'C' THEN 'Cancelled'
    ELSE T1."CRFSTATUS"END AS CRFSTATUS,T1."CRFREQDATE"
    FROM "STONEMEN_DCRFHEADER" T1 INNER JOIN "STONEMEN_DDATA" T2 ON T1."CRFREQGUID" = T2."OBJECTGUID"
    INNER JOIN "STONEMEN_CDATAFLOW" T3 ON T3."PARENT_DATAGUID" = T2."DATAGUID"
    LEFT JOIN "STONEMEN_CCRFSEEKADVICE" T5 ON T5."PARENT_CRFREQGUID" = T1."CRFREQGUID"
    LEFT JOIN "STONEMEN_MUSER" T4 ON T4."USERGUID" = T1."CREATEDBYUSERID_USERGUID"
    WHERE (T3."USER_USERGUID" = :GUID OR T5."QUESTIONFROMUSER_USERGUID" = :GUID)
    ORDER BY T1."CRFREQNO" DESC
);
  --if Data not exists in the A table 
  SELECT COUNT(*) INTO COUNTOFADATA FROM :A;
  IF COUNTOFADATA = 0 then 

    -- check login user from CRF Role or not
    SELECT CASE WHEN COUNT(*) > 0 THEN 1 ELSE 0 END INTO lv_exists FROM "STONEMEN_DTEMPLATE" T1
    INNER JOIN "STONEMEN_CTEMPLATEMENU" T2 ON T1."TEMPLATEGUID" = T2."PARENT_TEMPLATEGUID"
    INNER JOIN "STONEMEN_CTEMPLATESTAGE" T3 ON T1."TEMPLATEGUID" = T3."PARENT_TEMPLATEGUID"
    LEFT JOIN "STONEMEN_MSTAGE" T4 ON T4."STAGEGUID" = T3."STAGE_STAGEGUID"
    LEFT JOIN "STONEMEN_MMENU" T5 ON T5."MENUGUID" = T2."MENU_MENUGUID"
    WHERE T5."MENUCODE" = 'CRF'AND T1."DELMARK" = 0 AND T4."STAGEGUID" = :STAGEGUID;

    --Logged-in user does not belong to CRF
    IF lv_exists = 0 THEN

      A = (SELECT DISTINCT T1."CRFREQGUID", T1."CRFREQNO",
      CASE WHEN T1."REQTYP" = 'N' THEN 'New' WHEN T1."REQTYP" = 'R' THEN 'Repeat' ELSE T1."REQTYP" END AS "REQTYP",
      T1."CREATEDBYUSERID_USERGUID", T4."USERNAME", T1."BUYERNAME", T1."BUYERCODE",
      CASE 
      WHEN T1."CRFSTATUS" = 'N' THEN 'New' WHEN T1."CRFSTATUS" = 'WIP' THEN 'Work-in-Progress' WHEN T1."CRFSTATUS" = 'CLS' THEN REPLACE('Closed', '', '')
      WHEN T1."CRFSTATUS" = 'C' THEN 'Cancelled' ELSE T1."CRFSTATUS" END AS CRFSTATUS,T1."CRFREQDATE"
      FROM "STONEMEN_DCRFHEADER" T1
      LEFT JOIN "STONEMEN_MUSER" T4 ON T4."USERGUID" = T1."CREATEDBYUSERID_USERGUID"
      ORDER BY T1."CRFREQNO" DESC);

    END IF; 

  end if ; 
 

    Returndata =
    SELECT DISTINCT A."CRFREQGUID",
      A."CRFREQNO",
      A."REQTYP",
      A."CREATEDBYUSERID_USERGUID",
      A."USERNAME",
      A."BUYERNAME",
      A."BUYERCODE",
      A."CRFSTATUS",
      A."CRFREQDATE"
    FROM :A AS A
    WHERE (
        A."BUYERCODE" = :ActualBuyerCode
        OR (IFNULL(:ActualBuyerCode, '') = '')
      )
      AND (
    A."CRFREQNO" = :CRFREQNO
    OR (IFNULL(:CRFREQNO, 0) = 0)
      )
      AND (
    A."CRFSTATUS" = :ActualCRFSTATUS
    OR (IFNULL(:ActualCRFSTATUS, '') = '')
      )
      AND (
    A."REQTYP" = :ActualREQTYP
    OR (IFNULL(:ActualREQTYP, '') = '')
      )
      AND (
    (
      :ActualCRFREQDATE IS NULL
      AND A."CRFREQDATE" <= CURRENT_DATE
    )
    OR (
      :ActualCRFREQDATE IS NULL
      AND A."CRFREQDATE" <= CURRENT_DATE
    )
    OR (A."CRFREQDATE" = :ActualCRFREQDATE)
    ) ORDER BY A."CRFREQNO" DESC;    

END