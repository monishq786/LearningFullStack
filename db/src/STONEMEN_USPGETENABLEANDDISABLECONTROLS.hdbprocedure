PROCEDURE "STONEMEN_USPGETENABLEANDDISABLECONTROLS" (
    IN DOCUMENTGUID VARCHAR(200), 
    IN LOGINGUID NVARCHAR(200), 
    IN ROLECODE NVARCHAR(200), 
    IN STAGEGUID NVARCHAR(200), 
    OUT EnableTable TABLE (ControlName NVARCHAR(200),ControlId NVARCHAR(200),Enabled BOOLEAN))
  LANGUAGE SQLSCRIPT  SQL SECURITY INVOKER   READS SQL DATA 
  AS  BEGIN
	DECLARE RoleGuidFromDData NVARCHAR(200)= null;
	DECLARE STAGEGudiFromDData NVARCHAR(200)= null;
	DECLARE DDataCount INT = 0;
	DECLARE HOLDCOUNT INT = 0;
    DECLARE StageForAllControleFalse NVARCHAR(200)= null;
	DECLARE RoleForAllControleFalse NVARCHAR(200)= null;
	DECLARE DOCUMENTISNULL INT;
	
	--****************** thois condition  for add mode ********************************** 
	IF DOCUMENTGUID = 'null' THEN DOCUMENTISNULL :=10; END IF;
	-- select 20 into HOLDCOUNT from "STONEMEN_DCRFHEADER" WHERE "CRFREQGUID"=:DOCUMENTGUID AND  "CRFSTATUS"='HOLD';
	IF EXISTS (select * from "STONEMEN_DCRFHEADER" WHERE "CRFREQGUID"=:DOCUMENTGUID AND  "CRFSTATUS"='HOLD') THEN
		HOLDCOUNT := 20;
	END IF;
	IF EXISTS (
            SELECT 1
            FROM "STONEMEN_DDATA" T1 
            INNER JOIN "STONEMEN_CDATAFLOW" T2 ON T1."DATAGUID" = T2."PARENT_DATAGUID"
            LEFT JOIN "STONEMEN_MUSER" T3 ON T2."USER_USERGUID" = T3."USERGUID"
            WHERE T1."OBJECTGUID" =:DOCUMENTGUID  -- Document GUID
            AND T2."USER_USERGUID" =:LOGINGUID  -- Login GUID
            AND T1."STAGE_STAGEGUID" = :STAGEGUID  -- Stage From Document
            AND T1.DELMARK = 0  -- delmarks condition
            AND T2."ROWSTATUS" = 'OPEN'
        ) THEN
            -- Data exists, select the top record into variables
            SELECT TOP 1 
                T1."STAGE_STAGEGUID", 
                T3."ROLE_ROLEGUID", 
                30 
            INTO 
                STAGEGudiFromDData, 
                RoleGuidFromDData, 
                DDataCount
            FROM "STONEMEN_DDATA" T1 
            INNER JOIN "STONEMEN_CDATAFLOW" T2 ON T1."DATAGUID" = T2."PARENT_DATAGUID"
            LEFT JOIN "STONEMEN_MUSER" T3 ON T2."USER_USERGUID" = T3."USERGUID"
            WHERE 
                T1."OBJECTGUID" =:DOCUMENTGUID -- Document GUID
                AND T2."USER_USERGUID" =:LOGINGUID -- Login GUID
                AND T1."STAGE_STAGEGUID" = :STAGEGUID -- Stage From Document
                AND T1.DELMARK = 0  -- delmarks condition
                AND T2."ROWSTATUS" = 'OPEN';
                
        END IF;
	
	IF DOCUMENTISNULL = 10 THEN
	
		ENABLETABLE =
		SELECT "CONTROLNAME","CONTROLID","ENABLED"
    	FROM "STONEMEN_MCRFCONTROLS" T1 INNER JOIN "STONEMEN_MCRFCONTROLDETAIL" AS T2 ON T1."CONTROLSID" = T2."PARENT_CONTROLSID"  
    	WHERE T1."ROLECODE_ROLEGUID"=:ROLECODE AND T1."STAGECODE_STAGEGUID"=:STAGEGUID;
	
	ELSEIF HOLDCOUNT = 20 THEN 
		
		ENABLETABLE =
		SELECT "CONTROLNAME","CONTROLID",
    	CASE WHEN "ENABLED" = TRUE THEN FALSE ELSE "ENABLED" END AS "ENABLED"
    	FROM "STONEMEN_MCRFCONTROLS" T1 INNER JOIN "STONEMEN_MCRFCONTROLDETAIL" AS T2 ON T1."CONTROLSID" = T2."PARENT_CONTROLSID"  
    	WHERE T1."ROLECODE_ROLEGUID"=:ROLECODE AND T1."STAGECODE_STAGEGUID"=:STAGEGUID;
	
	ELSEIF DDataCount = 30 THEN 
	
		ENABLETABLE =
		SELECT "CONTROLNAME","CONTROLID","ENABLED"
    	FROM "STONEMEN_MCRFCONTROLS" T1 INNER JOIN "STONEMEN_MCRFCONTROLDETAIL" AS T2 ON T1."CONTROLSID" = T2."PARENT_CONTROLSID"  
    	WHERE T1."ROLECODE_ROLEGUID"=:ROLECODE AND T1."STAGECODE_STAGEGUID"=:STAGEGUID;
	
	
	ELSE
		
        ENABLETABLE = 
         SELECT "CONTROLNAME","CONTROLID","ENABLED"
         FROM "STONEMEN_MCRFCONTROLS" T1 INNER JOIN "STONEMEN_MCRFCONTROLDETAIL" AS T2 ON T1."CONTROLSID" = T2."PARENT_CONTROLSID"
         where "ROLECODE_ROLEGUID" IS NULL and "STAGECODE_STAGEGUID" IS NULL;

    END IF;

END;












