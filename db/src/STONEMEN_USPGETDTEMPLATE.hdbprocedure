PROCEDURE "STONEMEN_USPGETDTEMPLATE" (
    IN MENUSUBTYPE nvarchar(200),
    IN MENUENUM nvarchar(200), 
    OUT ReturnData TABLE (STAGEGUID NVARCHAR(255),STAGECODE NVARCHAR(255),STAGENAME NVARCHAR(255), TEMPLATEGUID NVARCHAR(255),TEMPLATENAME NVARCHAR(255))) 
  LANGUAGE SQLSCRIPT SQL SECURITY INVOKER  READS SQL DATA 
  AS BEGIN
	DECLARE MENUGUID NVARCHAR(200);
	
	IF MENUENUM = 'CRF' THEN
		SELECT "MENUGUID" INTO MENUGUID  FROM "STONEMEN_MMENU" WHERE "MENUCODE" = :MENUENUM AND "DELMARK" = 0;
    
	ELSEIF MENUENUM = 'CAD' THEN
      	SELECT "MENUGUID" INTO MENUGUID FROM "STONEMEN_MMENU" WHERE "MENUCODE" = :MENUENUM AND "DELMARK" = 0;

	ELSE
    	SELECT "MENUGUID" INTO MENUGUID FROM "STONEMEN_MMENU" WHERE "MENUCODE" = :MENUENUM AND "DELMARK" = 0;
	END IF;
	
	Returndata=(
	select T2."STAGE_STAGEGUID" AS "STAGEGUID" ,T4."STAGECODE",T4."DESCRIPTION" AS "STAGENAME",T1."TEMPLATEGUID" ,T1."TEMPLATENAME" from "STONEMEN_DTEMPLATE" T1 
	inner join "STONEMEN_CTEMPLATESTAGE" T2 on T1."TEMPLATEGUID" = T2."PARENT_TEMPLATEGUID"
	inner join STONEMEN_CTEMPLATEMENU T3 on T1."TEMPLATEGUID" = T3."PARENT_TEMPLATEGUID"
	left join "STONEMEN_MSTAGE" T4 on T4."STAGEGUID" = T2."STAGE_STAGEGUID"
	where T3."MENUSUBTYPE" =:MENUSUBTYPE and T3."MENU_MENUGUID" =:MENUGUID);
	
END;