PROCEDURE "STONEMEN_USPGETUSERSFORSELECTIONONCRF" (
    IN BUYERCODE NVARCHAR(50),
    IN PRODCATEGORYGUID NVARCHAR(50),
    IN PRODCATEGORYCODE NVARCHAR(50),
    IN MATERIALCATEGORYCODE NVARCHAR(50),
    OUT 
  ReturnData TABLE (
      ROLE_ROLEGUID NVARCHAR(255),
      USERGUID NVARCHAR(255),
      USERNAME NVARCHAR(255),
      USERROLECODE NVARCHAR(255),
      USERROLENAME NVARCHAR(255),
      MATERIALCATEGORYCODE NVARCHAR(255),
      MATERIALCATEGORYNAME NVARCHAR(255),
      USERPRODUCTCATEGORYGUID NVARCHAR(255),
      PRODUCTCATEGORYCODE NVARCHAR(255),
      PRODUCTCATEGORYNAME NVARCHAR(255)
    )
  ) 
  LANGUAGE SQLSCRIPT 
  SQL SECURITY INVOKER 
  READS SQL DATA AS 
BEGIN 
  /*
  A1 =(
  
  SELECT DISTINCT A."CRFREQGUID",
  A."CRFREQNO",
  A."INPUTTYPE",
  A."BUYERNAME",
  'Ankita' AS "USERNAME",
  A."CRFSTATUS",
  A."REQTYP"
  FROM "STONEMEN_DCRFHEADER" AS A
  ORDER BY A."CRFREQNO" DESC
  */
  Returndata =
  SELECT DISTINCT "ROLE_ROLEGUID",
    A."USERGUID",
    A."USERNAME",
    C."ROLECODE" AS "USERROLECODE",
    C."DESCRIPTION" AS "USERROLENAME",
    M."MATERIALCATEGORYCODE",
    M."MATERIALCATEGORYNAME",
    P."USERPRODUCTCATEGORYGUID",
    P."PRODUCTCATEGORYCODE",
    P."PRODUCTCATEGORYNAME"
  FROM "STONEMEN_MUSER" AS A
    INNER JOIN "STONEMEN_CUSERBUYER" AS B
   ON (
      A."USERGUID" = B."USER_USERGUID"
      AND A."DELMARK" = 0
      AND B."DELMARK" = 0
    )
    INNER JOIN "STONEMEN_CUSERPRODUCTCATEGORY" AS P
   ON (
      A."USERGUID" = P."PARENT_USERGUID"
      AND P."DELMARK" = 0
    )
    INNER JOIN "STONEMEN_CUSERMATERIALCATEGORY" AS M ON(
      A."USERGUID" = M."PARENT_USERGUID"
      AND M."DELMARK" = 0
    )
    INNER JOIN "STONEMEN_MROLE" C
   ON A."ROLE_ROLEGUID" = C."ROLEGUID"
  WHERE B."BUYERCODE" = :BUYERCODE
    AND M."MATERIALCATEGORYCODE" = :MATERIALCATEGORYCODE
    AND P."PRODUCTCATEGORYCODE" = :PRODCATEGORYCODE
  ORDER BY A."USERNAME";
  /*
  Returndata =
  SELECT DISTINCT A."CRFREQGUID",
  A."CRFREQNO",
  CASE
  WHEN A."INPUTTYPE" = 'I' THEN 'Internal'
  WHEN A."INPUTTYPE" = 'E' THEN 'External'
  ELSE A."INPUTTYPE"
  END AS "INPUTTYPE",
  A."BUYERNAME",
  A."USERNAME",
  CASE
  WHEN "CRFSTATUS" = 'New' THEN 'New'
  WHEN "CRFSTATUS" = 'CLS' THEN '
  Closed'
  WHEN "CRFSTATUS" = 'WIP' THEN 'In Progress'
  END "CRFSTATUS",
  CASE
  WHEN A."REQTYP" = 'N' THEN 'New'
  WHEN A."REQTYP" = 'R' THEN 'Repeat'
  ELSE A."REQTYP"
  END AS "REQTYPE"
  FROM :A1 AS A
  ORDER BY A."CRFREQNO" DESC;
  */
END;