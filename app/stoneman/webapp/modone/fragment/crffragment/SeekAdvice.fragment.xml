<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:u="sap.ui.unified"
    xmlns:commons="sap.suite.ui.commons">
    <VBox>
        <FlexBox justifyContent="End">
            <Button icon="sap-icon://add" id="raiseQuery" text="{i18n>raiseQuery}" press="addRaiseQuery" />
        </FlexBox>
        <ScrollContainer id="scrollCRFSeekAdvice" width="100%" height="auto" horizontal="true" vertical="true" focusable="true">
            <Table items="{    path: 'EntryFormDataSourceModel>/SeekAdvice',    sorter: {     path: 'Name'    }   }" id="seekAdviceTable" class="sapUiSizeCompact sapUiTinyMarginTop" inset="true" sticky="ColumnHeaders,HeaderToolbar" showSeparators="All" showNoData="true">
                <columns>
                    <Column width="5rem">
                        <Label text="{i18n>srNo}" />
                    </Column>
                    <Column width="10rem">
                        <Label text="Department" />
                    </Column>
                    <Column width="10rem">
                        <Label text="User" labelFor="user"/>
                    </Column>
                    <Column width="10rem">
                        <Label text="Role" />
                    </Column>
                    <Column width="10rem">
                        <Label text="Query" labelFor="comment"/>
                    </Column>
                    <!-- <Column width="10rem">
                        <Label text="File Name" />
                    </Column>
                    <Column width="6rem" /> -->
                    <Column width="15rem">
                        <Label text="Attachment" />
                    </Column>
                    <Column width="5rem">
                        <Label text="Reply" />
                    </Column>
                    <Column width="5rem" />
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <!-- <Text id="srNum_seek" text="{= ${EntryFormDataSourceModel>/SeekAdvice}.length}" /> -->
                            <Text id="srNum_seek" text="{EntryFormDataSourceModel>RowNumber}" />
                            <Input id="cadSeekDept" width="150px" placeholder="Click to select value" showValueHelp="true" value="{EntryFormDataSourceModel>DepartmentName}" valueHelpRequest="cflForDeptSeek" />
                            <Input id="cadSeekUser" required="true" width="150px" placeholder="Click to select value" showValueHelp="true" valueHelpRequest="cflForUserSeek" value="{EntryFormDataSourceModel>QuestionToUserName}" />
                            <Input id="roleInput" width="150px" editable="false" value="{EntryFormDataSourceModel>RoleName}" />
                            <Input id="comment" required="true" value="{EntryFormDataSourceModel>Question}" enabled="{EntryFormDataSourceModel>isQueryInputEnabled}" width="80%" liveChange=".onFieldChange"/>
                            <HBox>
                                <Button id="fileUploader2" icon="sap-icon://attachment" text="Attachment" press="openSeekAttachmentDialog" class="sapUiSmallMarginBegin"/>
                            </HBox>
                            <Button id="action" icon="sap-icon://action" type="Emphasized" press="openDialog" enabled="{EntryFormDataSourceModel>isReplyEnabled}"/>
                            <Button icon="sap-icon://delete" press="onDeleteSeekAdvice" type="Reject" />

                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </ScrollContainer>
        <FlexBox justifyContent="End">
            <Button type="Emphasized" id="addSeek" text="{i18n>addSeekAdvice}" press="onUploadPressSeekAdvice" class="sapUiSmallMarginTop"/>
        </FlexBox>

    </VBox>
</core:FragmentDefinition>