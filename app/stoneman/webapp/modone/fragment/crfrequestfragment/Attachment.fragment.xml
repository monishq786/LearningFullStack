<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:u="sap.ui.unified"
    xmlns:commons="sap.suite.ui.commons">
    <VBox >
        <FlexBox justifyContent="End" visible="{EntryFormDataSourceModel>/isButtonVisible}">
            <Button id="CRF_addAttachBtn" icon="sap-icon://add" text="{i18n>addDrawing}" press="addAttachment" enabled="true" class="sapUiSmallMarginBegin"/>
        </FlexBox>
        <f:SimpleForm id="AttachmentForm" editable="true" layout="ColumnLayout" columnsM="2" columnsL="4" columnsXL="4" labelSpanL="4" labelSpanXL="4" adjustLabelSpan="true">
            <f:content>
                <Label id="prodEngg" labelFor="assignProdEng" text="Assign Prod. Eng" />
                <Select id="assignProdEng" required="true" width="150px" maxWidth="100%" valueState="None" visible="true" editable="true" change="onSelectAssnProdEng" items="{path: 'AssgnEnggModel>/value'}" selectedKey="{EntryFormDataSourceModel>/UserID}">
                    <core:Item key="{AssgnEnggModel>UserID}" text="{AssgnEnggModel>Username}" />
                </Select>
                <Label id="attachProd" text="Prod. Eng Attachment" />
                <u:FileUploader id="prodEnggAttach" multiple="false" name="myFileUpload" uploadUrl="/upload" change=".onFileChangeDesigner" uploadComplete=".onUploadComplete" buttonText="Choose File" placeholder="Choose a file to upload" />
                <Label id="attachTech" text="Tech Attachment" />
                <u:FileUploader id="techAttachFile" multiple="false" name="myFileUpload" uploadUrl="/upload" change=".onFileChangeTech" buttonText="Choose File" placeholder="Choose a file to upload" />
            </f:content>
        </f:SimpleForm>

        <ScrollContainer id="scrollAttachment" width="100%" height="auto" horizontal="true" vertical="true" focusable="true">
            <Table id="cadTable" items="{ path: 'EntryFormDataSourceModel>/InspDraw',    sorter: {     path: 'SrNo'    }   }" class="sapUiSizeCompact" inset="true" sticky="ColumnHeaders,HeaderToolbar" showSeparators="All" showNoData="true">
                <columns>
                    <Column width="5rem">
                        <Text text="{i18n>srNo}" />
                    </Column>

                    <Column width="15rem">
                        <Text text="{i18n>inspRefName}" />
                    </Column>

                    <Column width="10rem">
                        <Text text="{i18n>inspRefNo}" />
                    </Column>

                    <Column width="10rem">
                        <Text text="{i18n>inspRefDoc}" />
                    </Column>

                    <Column width="10rem" />

                    <Column width="15rem" />

                    <Column width="10rem">
                        <Text text="{i18n>assProdEng}" />
                    </Column>

                    <Column width="10rem">
                        <Text text="{i18n>prodEngAttach}" />
                    </Column>

                    <Column width="10rem" />

                    <Column width="15rem">
                        <Text text="{i18n>techAttach}" />
                    </Column>

                    <Column width="10rem" />

                    <Column width="10rem">
                        <Text text="{i18n>group}" />
                    </Column>

                    <Column width="10rem">
                        <Text text="{i18n>appStatus}" />
                    </Column>

                    <Column width="5rem" />
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle">
                        <Text id="srNum_attach" text="{EntryFormDataSourceModel>RowNumber}" />
                        <Input id="insprRefName" value="{EntryFormDataSourceModel>InspRefName}" placeholder="Enter" description="" width="120px" fieldWidth="100%" />
                        <Text id="insprRefNum" text="{EntryFormDataSourceModel>InspRefNo}" wrapping="false" />
                        <Text id="insprRefDoc" text="{EntryFormDataSourceModel>AttachFileName}" wrapping="true" />
                        <HBox id="hBoxInspView" visible="{EntryFormDataSourceModel>isDownloadVisible}">
                            <Button id="viewBtn" icon="sap-icon://show" press="onViewFile" />
                            <Button id="downloadBtn" icon="sap-icon://download" press="onDownloadFile" class="sapUiSmallMarginBegin"/>
                        </HBox>
                        <HBox>
                            <u:FileUploader id="fileUploader" enabled="{isComboBoxEnabled}" multiple="false" name="myFileUpload" uploadUrl="/upload" change=".onFileChange" uploadComplete=".onUploadComplete" buttonText="Choose File" placeholder="Choose a file to upload" />
                        </HBox>
                        <Text id="AssProdEngg" wrapping="true" text="{EntryFormDataSourceModel>AssignProd}" />
                        <Text id="ProdEnggAttach" text="{EntryFormDataSourceModel>DraftRemarks}" wrapping="true" />
                        <HBox id="hBoxProdView" visible="{EntryFormDataSourceModel>isDownloadVisibleDraft}">
                            <Button id="viewBtnProd" icon="sap-icon://show" press="onViewFile" />
                            <Button id="downloadBtnProd" icon="sap-icon://download" press="onDownloadFile" class="sapUiSmallMarginBegin"/>
                        </HBox>
                        <Text id="techAttach" text="{EntryFormDataSourceModel>TechRemarks}" wrapping="true" />
                        <HBox id="hBoxTechView" visible="{EntryFormDataSourceModel>isDownloadVisibleTech}">
                            <Button id="viewBtnTech" icon="sap-icon://show" press="onViewFile" />
                            <Button id="downloadBtnTech" icon="sap-icon://download" press="onDownloadFile" class="sapUiSmallMarginBegin"/>
                        </HBox>
                        <Text id="groupid" text="{EntryFormDataSourceModel>GroupId}" wrapping="true" />
                        <Text id="apprStatus" text="{EntryFormDataSourceModel>ApprovalStatus}" wrapping="true" />
                        <Button id="attachDelBtn" icon="sap-icon://delete" width="35px" visible="true" press="onDeleteAttachment" type="Reject" />
                    </ColumnListItem>
                </items>
            </Table>
        </ScrollContainer>
    </VBox>
</core:FragmentDefinition>