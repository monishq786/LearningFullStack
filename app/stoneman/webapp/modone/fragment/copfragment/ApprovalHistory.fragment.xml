<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <ScrollContainer
        width="100%"
        height="100%"
        horizontal="true"
        vertical="true"
   
    >
        <Table
            items="{    path: 'EntryFormDataSourceModel>/CostingApprovalTransaction',  
          sorter: {     path: 'Name'    }   }"
            id="copefApprovelHistoryTable"
        >
            <columns>
                <Column width="140px">
                    <Text text="User" />
                </Column>
                <Column width="140px">
                    <Text text="Role" />
                </Column>
                <Column width="140px">
                    <Text text="Stage" />
                </Column>
                <Column width="140px">
                    <Text text="Date" />
                </Column>

                <Column width="140px">
                    <Text text="Comments" />
                </Column>
                <Column width="140px">
                    <Text text="Approval Status" />
                </Column>
                <Column width="140px">
                    <Text text="Row Status" />
                </Column>
            </columns>
            <items>
                <ColumnListItem vAlign="Middle">
                    <cells>
                        <Text
                            text="{EntryFormDataSourceModel>UserId_UserID}"
                            wrapping="false"
                        />
                        <Text
                            text="{EntryFormDataSourceModel>UserRoleId_RoleCode_RoleConstant}"
                            wrapping="false"
                        />
                        <Text
                            text="{EntryFormDataSourceModel>StageId_StageCode_StageConstant}"
                            wrapping="true"
                        />
                        <Text
                            text="{EntryFormDataSourceModel>ProcessDate}"
                            wrapping="false"
                        />
                        <Text
                            text="{EntryFormDataSourceModel>Comments}"
                            wrapping="false"
                        />
                        <Text
                            text="{EntryFormDataSourceModel>ApprovalStatus}"
                            wrapping="false"
                        />
                        <Text
                            text="{EntryFormDataSourceModel>RowStatus}"
                            wrapping="false"
                        />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </ScrollContainer>
</core:FragmentDefinition>
