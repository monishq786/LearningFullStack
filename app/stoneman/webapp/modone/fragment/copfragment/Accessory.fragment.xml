<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <ScrollContainer
        width="100%"
        height="100%"
        horizontal="true"
        vertical="true"
 
    >
        <Table
            items="{    path: 'copRequestModel_New>/Accessory',    sorter: {     path: ''    }   }"
          
            inset="true"
            sticky="ColumnHeaders,HeaderToolbar"
            showSeparators="All"
            showNoData="true"
            id="copefAccessoryTable"
        >
            <columns>
                <Column width="160px">
                    <Text text="{i18n>field1Lbl}" />
                </Column>
                <Column width="140px">
                    <Text text="{i18n>dimensionLbl}" />
                </Column>
                <Column width="140px">
                    <Text text="{i18n>QtyLbl}" />
                </Column>
                <Column width="140px">
                    <Text text="{i18n>uomLbl}" />
                </Column>
                <Column width="140px">
                    <Text text="{i18n>UnitPriceLbl}" />
                </Column>
                <Column width="140px">
                    <Text text="{i18n>unitCostLbl}" />
                </Column>
                <Column width="140px">
                    <Text text="{i18n>ProductPercentLbl}" />
                </Column>
                <Column width="150px">
                    <Text text="{i18n>jobWorkCharge1Lbl}" />
                </Column>
                <Column width="150px">
                    <Text text="{i18n>jobWorkCharge2Lbl}" />
                </Column>
                <Column width="150px">
                    <Text text="{i18n>jobWorkCharge3Lbl}" />
                </Column>
                <Column width="140px">
                    <Text text="{i18n>assemblyFittingChargesLbl}" />
                </Column>
                <Column width="190px">
                    <Text text="{i18n>totaljobworkLbl}" />
                </Column>
                <Column width="140px">
                    <Text text="{i18n>overheadPercentageLbl}" />
                </Column>
                <Column width="140px">
                    <Text text="{i18n>ohAmountLbl}" />
                </Column>
                <Column width="140px">
                    <Text text="{i18n>wastagePercentageLbl}" />
                </Column>
                <Column width="140px">
                    <Text text="{i18n>wastageCostLbl}" />
                </Column>
                <Column width="140px">
                    <Text text="{i18n>totalCostOfItemIncludeAllProcessLbl}" />
                </Column>
            </columns>
            <items>
                <ColumnListItem vAlign="Middle">
                    <cells>
                         
                        <Text
                            id="copefAccessoryField"
                            text="{copRequestModel_New>Field}"
                        />
                        <Input
                            id="copefAccessoryDimensionMDF"
                            enabled="true"
                            value="{copRequestModel_New>/Dimension}"
                            description=""
                            fieldWidth="100%"
                        />
                        <Input
                            id="copefAccessoryQtyMDF"
                            enabled="true"
                            value="{copRequestModel_New>/Quantity}"
                            description=""
                            fieldWidth="100%"
                        />
                        <Input
                            id="copefAccessoryUomMDF"
                            enabled="true"
                            value="{copRequestModel_New>/UnitPrice}"
                            description=""
                            fieldWidth="100%"
                        />
                        <Input
                            id="copefAccessoryUnitpriceMDF"
                            enabled="true"
                            value="{copRequestModel_New>/UnitCost}"
                            description=""
                            fieldWidth="100%"
                        />
                        <Input
                            id="copefAccessoryUnitcostMDF"
                            enabled="true"
                            value="{copRequestModel_New>/Productivity}"
                            description=""
                            fieldWidth="100%"
                        />
                        <Input
                            id="copefAccessoryProductpercentMDF"
                            enabled="true"
                            value="{copRequestModel_New>/JobWorkChange-1}"
                            description=""
                            fieldWidth="100%"
                        />
                        <Input
                            id="copefAccessoryJobwork1MDF"
                            enabled="true"
                            value="{copRequestModel_New>/JobWorkChange-2}"
                            description=""
                            fieldWidth="100%"
                        />
                        <Input
                            id="copefAccessoryJobwork2MDF"
                            enabled="true"
                            value="{copRequestModel_New>/JobWorkChange-3}"
                            description=""
                            fieldWidth="100%"
                        />
                        <Input
                            id="copefAccessoryJobwork3MDF"
                            enabled="true"
                            value="{copRequestModel_New>/Assembly/FittingCharge}"
                            description=""
                            fieldWidth="100%"
                        />
                        <Input
                            id="copefAccessoryAssemblyMDF"
                            enabled="true"
                            value="{copRequestModel_New>/Total}"
                            description=""
                            fieldWidth="100%"
                        />
                        <Input
                            id="copefAccessoryTotalMDF"
                            enabled="true"
                            value="{copRequestModel_New>/Over}"
                            description=""
                            fieldWidth="100%"
                        />
                        <Input
                            id="copefAccessoryOverheadpercentMDF"
                            enabled="true"
                            value="{copRequestModel_New>/OHAmount}"
                            description=""
                            fieldWidth="100%"
                        />
                        <Input
                            id="copefAccessoryOHAmountMDF"
                            enabled="true"
                            value="{copRequestModel_New>/WastagePercentage}"
                            description=""
                            fieldWidth="100%"
                        />
                        <Input
                            id="copefAccessoryWastagepercentMDF"
                            enabled="true"
                            value="{copRequestModel_New>/WastageCost}"
                            description=""
                            fieldWidth="100%"
                        />
                        <Input
                            id="copefAccessoryWastagecostMDF"
                            enabled="true"
                            value="{copRequestModel_New>/localHandlingPercentage}"
                            description=""
                            fieldWidth="100%"
                        />
                        <Input
                            id="copefAccessoryTitalcostMDF"
                            enabled="true"
                            value="{copRequestModel_New>/TotalCostOfItem}"
                            description=""
                            fieldWidth="100%"
                        />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </ScrollContainer>
</core:FragmentDefinition>
