<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <VBox>
        <f:SimpleForm
            id="copefPackingcopefPackingContainer"
            editable="true"
            layout="ColumnLayout"
            columnsM="3"
            columnsL="4"
            columnsXL="5"
        >
            <f:content>
                <Label
                    labelFor="copefPackingPackingCost"
                    text="{i18n>PackingCostLbl}"
                />
                <Input
                    id="copefPackingPackingCost"
                    enabled="true"
                    value="{EntryFormDataSourceModel>/PackingCost}"
                />
                <Label
                    labelFor="copefPackingBrandPackingCost"
                    text="{i18n>BrandPackingCostLbl}"
                />
                <Input
                    id="copefPackingBrandPackingCost"
                    enabled="true"
                    value="{EntryFormDataSourceModel>/BrandPackingCost}"
                />
                <Label
                    labelFor="copefPackingInnerBoxL"
                    text="{i18n>InnerBoxLLbl}"
                />
                <Input
                    id="copefPackingInnerBoxL"
                    enabled="true"
                    value="{EntryFormDataSourceModel>/InnerBoxL}"
                />
                <Label
                    labelFor="copefPackingInnerBoxW"
                    text="{i18n>InnerBoxWLbl}"
                />
                <Input
                    id="copefPackingInnerBoxW"
                    enabled="true"
                    value="{EntryFormDataSourceModel>/InnerBoxW}"
                />

                <Label
                    labelFor="copefPackingInnerBoxH"
                    text="{i18n>InnerBoxHLbl}"
                />
                <Input
                    id="copefPackingInnerBoxH"
                    enabled="true"
                    value="{EntryFormDataSourceModel>/InnerBoxH}"
                />

                <Label
                    labelFor="copefPackingUomPacking"
                    text="{i18n>uomPackingLbl}"
                />

                <Select
                    id="copefPackingUomPacking"
                    valueState="None"
                    selectedKey="{EntryFormDataSourceModel>/InnerBoxUOM}"
                    items="{EntryFormDataSourceModel>/uom}"
                >
                    <items>
                        <core:Item
                            key="{EntryFormDataSourceModel>id}"
                            text="{EntryFormDataSourceModel>name}"
                        />
                    </items>
                </Select>

                <Label
                    labelFor="copefPackingMasterCartoonL"
                    text="{i18n>masterCartoonLLbl}"
                />
                <Input
                    id="copefPackingMasterCartoonL"
                    enabled="true"
                    value="{EntryFormDataSourceModel>/MasterCartoonL}"
                />

                <Label
                    labelFor="copefPackingMasterCartoonW"
                    text="{i18n>masterCartoonWLbl}"
                />
                <Input
                    id="copefPackingMasterCartoonW"
                    enabled="true"
                    value="{EntryFormDataSourceModel>/MasterCartoonW}"
                />

                <Label
                    labelFor="copefPackingMasterCartoonH"
                    text="{i18n>masterCartoonHLbl}"
                />
                <Input
                    id="copefPackingMasterCartoonH"
                    value="{EntryFormDataSourceModel>/MasterCartoonH}"
                />

                <Label
                    labelFor="copefPackingUomMasterCartoon"
                    text="{i18n>uomMasterCartoonLbl}"
                />
                <Select
                    id="copefPackingUomMasterCartoon"
                    valueState="None"
                    selectedKey="{EntryFormDataSourceModel>/MasterCartoonUOM}"
                    items="{EntryFormDataSourceModel>/uom}"
                >
                    <items>
                        <core:Item
                            key="{EntryFormDataSourceModel>id}"
                            text="{EntryFormDataSourceModel>name}"
                        />
                    </items>
                </Select>

                <Label
                    labelFor="copefPackingCasePack"
                    text="{i18n>casePackLbl}"
                />
                <Input
                    id="copefPackingCasePack"
                    value="{EntryFormDataSourceModel>/CasePack}"
                />

                <Label
                    labelFor="copefPackingCBM"
                    text="{i18n>cbmLbl}"
                />
                <Input
                    id="copefPackingCBM"
                    value="{EntryFormDataSourceModel>/CBM}"
                />

                <Label
                    labelFor="copefPackingCostPerCBM"
                    text="{i18n>costpercbmLbl}"
                />
                <Input
                    id="copefPackingCostPerCBM"
                    value="{EntryFormDataSourceModel>/CostPerCBM}"
                />

                <Label
                    labelFor="copefPackingOverHead"
                    text="{i18n>overheadLbl}"
                />
                <Input
                    id="copefPackingOverHead"
                    value="{EntryFormDataSourceModel>/Overhead}"
                />
            </f:content>
        </f:SimpleForm>
    </VBox>
</core:FragmentDefinition>
