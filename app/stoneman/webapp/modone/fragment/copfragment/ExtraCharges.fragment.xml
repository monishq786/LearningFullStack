<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <VBox>
        <f:SimpleForm
            id="copefExtraChargesContainer"
            editable="true"
            layout="ColumnLayout"
            columnsM="3"
            columnsL="4"
            columnsXL="5"
        >
            <f:content>
                <Label
                    labelFor="copefExtraChargesTotalCost"
                    text="{i18n>TotalCostLbl}"
                />
                <Input
                    id="copefExtraChargesTotalCost"
                    enabled="true"
                    value="{EntryFormDataSourceModel>/TotalCost}"
                />

                <Label
                    labelFor="copefExtraChargesExchangeRate"
                    text="{i18n>exchangeRateLbl}"
                />
                <Input
                    id="copefExtraChargesExchangeRate"
                    enabled="true"
                    value="{EntryFormDataSourceModel>/ExchangeRate}"
                />
                <Label
                    labelFor="copefExtraChargesPriceInUS"
                    text="{i18n>priceInUSLbl}"
                />
                <Input
                    id="copefExtraChargesPriceInUS"
                    enabled="true"
                    value="{EntryFormDataSourceModel>/PriceinUS}"
                />
                <Label
                    labelFor="copefExtraChargesShippingCost"
                    text="{i18n>shippingCostLbl}"
                />
                <Input
                    id="copefExtraChargesShippingCost"
                    enabled="true"
                    value="{EntryFormDataSourceModel>/ShippingCost}"
                />
                <Label
                    labelFor="copefExtraChargesTestingCharge"
                    text="{i18n>testingChargeLbl}"
                />
                <Input
                    id="copefExtraChargesTestingCharge"
                    enabled="true"
                    value="{EntryFormDataSourceModel>/TestingCharge}"
                />
                <Label
                    labelFor="copefExtraChargesLabelingCharge"
                    text="{i18n>labelingChargeLbl}"
                />
                <Input
                    id="copefExtraChargesLabelingCharge"
                    enabled="true"
                    value="{EntryFormDataSourceModel>/LabellingCharge}"
                />

                <Label
                    labelFor="copefExtraChargesTrimmingCost"
                    text="{i18n>trimmingCostLbl}"
                />
                <Input
                    id="copefExtraChargesTrimmingCost"
                    value="{EntryFormDataSourceModel>/TrimmingCost}"
                />

                <Label
                    labelFor="copefExtraChargesPriceIncludingAllCharges"
                    text="{i18n>priceIncludingAllChargesLbl}"
                />
                <Input
                    id="copefExtraChargesPriceIncludingAllCharges"
                    value="{EntryFormDataSourceModel>/PriceIncAlCharges}"
                />

                <Label
                    labelFor="copefExtraChargesprofitLbl"
                    text="{i18n>profitLbl}"
                />
                <Input
                    id="copefExtraChargesProfit"
                    value="{EntryFormDataSourceModel>/Profit}"
                />

                <Label
                    labelFor="copefExtraChargesWeightExtraCharges"
                    text="{i18n>weightExtraChargesLbl}"
                />
                <Input
                    id="copefExtraChargesWeightExtraCharges"
                    value="{EntryFormDataSourceModel>/ExtraWEIGHT}"
                />

                <Label
                    labelFor="copefExtraChargesRemarksExtraCharge"
                    text="{i18n>remarksExtraChargesLbl}"
                />
                <Input
                    id="copefExtraChargesRemarksExtraCharge"
                    value="{EntryFormDataSourceModel>/ExtraRemarks}"
                />
            </f:content>
        </f:SimpleForm>
    </VBox>
</core:FragmentDefinition>
