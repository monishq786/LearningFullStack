<core:FragmentDefinition controllerName="modonecontroller.SeekAdviceCommentDialog"
xmlns="sap.m" 
xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form"
 >
 <!-- dialog for seek advice -->
     <Dialog id="commentDialog" title="{i18n>dialogTitleComment}" class="sapMText.message boldTitle">
        <content>
        <HBox class="tab-padding">
            <VBox>
            <Label id="commentLbl" text="{i18n>commentLbl}"
          width="100px"   class="labelHeightDialog"
        /> 
         <Label id="replyLbl" text="{i18n>replyLbl}"
          width="100px"   class="labelHeightDialog"
        /> 
            </VBox>
             <VBox>

          <TextArea id="queryField" value="{dialogData>/Question}" editable="false" placeholder="Enter query"
      width="250px" rows="2" class="labelHeight commentmargin"
        />
        <TextArea id="replyDialog" placeholder="Reply"  value="{dialogData>/Answer}"
      width="250px" rows="2"  class="labelHeight"      
        />
            </VBox>
            </HBox>
        </content>
        <buttons>
         <Button text="Save" press=".onSendDialog"/>
            <Button text="Close" press=".onCloseDialog"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>