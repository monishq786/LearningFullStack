<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Table id="myTable" items="{/items}">
        <columns>
            <Column>
                <Text text="Select" />
            </Column>
            <Column>
                <Text text="Options" />
            </Column>
        </columns>
        <items>
            <ColumnListItem>
                <cells>
                    <Checkbox selected="{selected}" />
                    <HBox>
                        <Checkbox selected="{option1}" />
                        <Checkbox selected="{option2}" />
                        <Checkbox selected="{option3}" />
                    </HBox>
                </cells>
            </ColumnListItem>
        </items>
    </Table>
</core:FragmentDefinition>
