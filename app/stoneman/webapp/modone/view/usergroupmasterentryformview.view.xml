        <mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" controllerName="your.namespace.Controller">
    <Table id="myTable" items="{/items}">
        <columns>
            <Column>
                <Text text="Item" />
            </Column>
            <Column>
                <Text text="Action" />
            </Column>
        </columns>
        <items>
            <ColumnListItem>
                <cells>
                    <Text text="{itemName}" />
                    <Button text="Open Details" press="onOpenFragment" />
                </cells>
            </ColumnListItem>
        </items>
    </Table>
</mvc:View>

