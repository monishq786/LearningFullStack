<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <VBox>
        <HBox width="100%" justifyContent="End">
            <VBox >
                <Button icon="sap-icon://add" text="{i18n>addNew}" press="addRowMeterialCategory" />
            </VBox>
        </HBox>
        <ScrollContainer width="100%" height="300px" horizontal="true" vertical="true">
            <Table items="{ path: 'EntryFormDataSourceModel>/MaterialCategory', sorter: { path: '' } }" class="sapUiSizeCompact" inset="true" sticky="ColumnHeaders,HeaderToolbar" showSeparators="All" showNoData="true" id="materialCategoryTable">
                <columns>
                    <Column width="4rem">
                        <Label text="Sr No"/>
                    </Column>
                    <Column width="8rem">
                        <Label text="Material Category Code" labelFor="material_category_code"/>
                    </Column>
                    <Column width="10rem">
                        <Label text="Material Category Name"/>
                    </Column>
                    <Column width="2rem" />
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <Text id="material_SrNo" text="{EntryFormDataSourceModel>RowNumber}" />
                            <Input id="material_category_code" required="true" width="200px" placeholder="Select Material Category" value="{EntryFormDataSourceModel>MaterialCategoryCode}" fieldWidth="100%" valueHelpRequest="cflForMaterialCategory" liveChange="onLiveChange" showValueHelp="true" />
                            <Input id="material_category_name" width="200px" editable="false" value="{EntryFormDataSourceModel>MaterialCategoryName}" fieldWidth="100%" tooltip="{EntryFormDataSourceModel>MaterialCategoryName}" />
                            <Button icon="sap-icon://delete" press="onDeleteMaterialCategory" type="Reject" width="35px" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </ScrollContainer>

    </VBox>
</core:FragmentDefinition>