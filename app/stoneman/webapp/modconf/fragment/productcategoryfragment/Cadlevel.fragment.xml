<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <VBox>
        <HBox width="100%" justifyContent="End">
            <VBox >
                <Button icon="sap-icon://add" text="{i18n>addNew}" press="addRow" />
            </VBox>
        </HBox>
        <ScrollContainer width="100%" height="300px" horizontal="true" vertical="true">
            <Table items="{ path: 'EntryFormDataSourceModel>/ProductCategoryCADLevel' }" class="sapUiSizeCompact" inset="true" sticky="ColumnHeaders,HeaderToolbar" showSeparators="All" showNoData="true" id="cadleveltb">
                <columns>
                    <Column width="4rem">
                        <Label text="Sr No"/>
                    </Column>
                    <Column width="8rem">
                        <Label text="CAD Level" labelFor="cadlevel"/>
                    </Column>
                    <Column width="10rem">
                        <Label text="Increment By"/>
                    </Column>
                    <Column width="2rem" />
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <Text id="cad_SrNo" text="{EntryFormDataSourceModel>RowNumber}"/>
                            <!-- <Input id="cadlevel" required="true" width="200px" placeholder="Select Buyer" value="{EntryFormDataSourceModel>CADLevel}" fieldWidth="100%" valueHelpRequest="cflForBuyer" showValueHelp="true" liveChange="onLiveChange" /> -->
                            
                                <ComboBox
                                    id="cadlevel"
                                    selectedKey="{EntryFormDataSourceModel>CADLevelCode}"
                                    change="handleCADLevelSelectionChange"
                                    items="{
                                        path: 'pcefSelectCadlevelModel>value'
                                    }"
                                    
                                >
                                    <core:Item
                                        key="{pcefSelectCadlevelModel>EnumCode}"
                                        text="{pcefSelectCadlevelModel>EnumDescription}"
                                    />
                                </ComboBox>
                            <Input id="cadvalue" width="200px" editable="true" type="Number" value="{EntryFormDataSourceModel>IncrementBy}" fieldWidth="100%"/>
                            <Button icon="sap-icon://delete" press="onDeleteCad" type="Reject" width="35px" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </ScrollContainer>

    </VBox>
</core:FragmentDefinition>