<mvc:XMLView
    controllerName="modconfcontroller.roleentryform"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    class="d-flex justify-content-center"
    height="94%"
>
    <Page
        id="roletef"
        title="{i18n>RoleCodeEnteryFormTitle}"
        showNavButton="true"
        navButtonPress="onPressOfEntryFormCancelButton"
    >
        <VBox>
            <f:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                columnsXL="1"
                columnsL="1"
                columnsM="1"
                singleContainerFullSize="false"
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="3"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="4"
                emptySpanL="4"
                emptySpanM="4"
                emptySpanS="0"
            >
                <f:content>
                    

                    <Label
                        id="RoleCodel"
                        text="{i18n>RoleCode}"
                        required="true"
                        class="m-mast-lev"
                    />
                    <Input

                      
                            id="RoleCodei"
                            type="Text"
                            value="{EntryFormDataSourceModel>/RoleCode}"
                            placeholder="Select Role ..."
                            showValueHelp="true"
                            valueHelpRequest="cflForRoleCode"
                            required="true"
                            enabled="{EnableCheck>/EnableRoleCode}"
                           
                           
                        />
                        <Label
                        id="RoleDescription"
                        text="{i18n>RoleDescription}"
                        required="true"
                        class="m-mast-lev"
                    />
                    <Input
                        id="RoleNamei"
                        value="{EntryFormDataSourceModel>/Description}"
                        required="true"
                        enabled="true"
                        class="m-mast-input"
                    />
                        <!-- id="RoleCodei"
                        value="{EntryFormDataSourceModel>/RoleCode_RoleConstant}"
                        required="true"
                        enabled="{EnableCheck>/EnableRoleCode}"
                        class="m-mast-input" -->
                    

                    <Label
                        text="Activel"
                        class="m-mast-lev"
                    />
                    <!-- <CheckBox
                        id="IsACheck"
                        selected="{EntryFormDataSourceModel>/IsActive}"
                        enabled="true"
                    /> -->
                </f:content>
            </f:SimpleForm>
        </VBox>
        <footer>
            <Toolbar class="d-flex justify-content-center btn-sav">
                <ToolbarSpacer />
                <Button id="Role_Button"
                    type="Emphasized"
                    text="{i18n>Submit}"
                    press=".onSave"
                />
                <Button 
                    type="Reject"
                    text="{i18n>cancel}"
                    press=".onCancel"
                    class="can-btn"
                />
            </Toolbar>
        </footer>
    </Page>
</mvc:XMLView>
