                    <m:Button type="Accept" id="btnApprove" text="{i18n>approve}" press="openDialogApprove"/>
                    <m:Text width="10px" />
                    <m:Button id="btnReject" type="Reject" text="{i18n>reject}" press="openDialogReject"/>
                    <m:Text width="10px" />
                    <m:Button id="btnHold" type="Emphasized" text="Hold" press="" icon="sap-icon://pending"/>
                    <m:Text width="10px" />
                    <m:Button type="Emphasized" id="btnSave" text="{i18n>save}" press="onUploadPress"/>
                    <m:Text width="10px" />
                    <m:Button type="Emphasized" id="btnSubmit" text="{i18n>submit}" press="onUploadPress"/>
                    <m:Text width="10px" />
                    <m:Button id="btnPrint" type="Emphasized" text="{i18n>printForm}" press="onRouterClicknewprint" icon="sap-icon://print"/>
                </m:FlexBox> -->
