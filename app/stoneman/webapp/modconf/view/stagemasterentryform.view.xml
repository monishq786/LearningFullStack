<mvc:XMLView
    controllerName="modconfcontroller.stagemasterentryform"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    class="d-flex justify-content-center"
>
    <Page
        id="stagemasterf"
        title="Stage Master Form"
        showNavButton="true"
        navButtonPress="onPressOfEntryFormCancelButton"
    >
        <VBox>
            <f:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                columnsXL="1"
                columnsL="1"
                columnsM="1"
                singleContainerFullSize="false"
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="3"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="4"
                emptySpanL="4"
                emptySpanM="4"
                emptySpanS="0"
            >
                <f:content>
                    <Label
                        id="stgcodelb"
                        text="{i18n>StageCode}"
                        required="true"
                    />
                    <Input
                        id="stgcode"
                        type="Text"
                        value="{EntryFormDataSourceModel>/StageCode}"
                        placeholder="Select Stage ..."
                        showValueHelp="true"
                        valueHelpRequest="cflForStageCode"
                        required="true"
                        enabled="{EnableCheck>/StageCode}"
                    />

                    <Label
                        id="stagedesclbl"
                        text="{i18n>stagedescription}"
                        required="true"
                        class="m-mast-lev"
                    />
                    <Input
                        id="stagedesc"
                        value="{EntryFormDataSourceModel>/Description}"
                        required="true"
                        enabled="true"
                        class="m-mast-input"
                    />

                    <Label
                        text="Approval"
                    />
                    <HBox
                        alignItems="Center"
                        justifyContent="Start"
                    >
                        <!-- <CheckBox selected="{= ${EntryFormDataSourceModel>/IsWorkFlow} === 'Y' }" required="true" enabled="true" id="workflowCheckBox"  /> -->
                        <!-- <Label text="Approval" required="true"   /> -->
                        <CheckBox
                            selected="{= ${EntryFormDataSourceModel>/IsApproval} === 'Y' }"
                            id="isApprovalCheckBox"
                            required="true"
                            enabled="true"
                            select="onSelect"
                            class="ml-10"
                        />
                    </HBox>

                    <Label
                        text="Send Email"
                        required="true"
                        class="m-mast-lev"
                    />

                    <ComboBox
                        id="sendEmail"
                        required="true"
                        maxWidth="100%"
                        valueState="None"
                        visible="true"
                        editable="true"
                        selectedKey="{EntryFormDataSourceModel>/SendEmail}"
                        class="m-mast-input"
                        change="changeSelect2"
                    >
                        <core:Item
                            key="Y"
                            text="Yes"
                        />
                        <core:Item
                            key="N"
                            text="No"
                        />
                    </ComboBox>

                    <Label
                        text="Send App Notification"
                        required="true"
                        class="m-mast-lev"
                    />

                    <ComboBox
                        id="sendAppNotification"
                        required="true"
                        maxWidth="100%"
                        valueState="None"
                        visible="true"
                        editable="true"
                        selectedKey="{EntryFormDataSourceModel>/SendAppNotification}"
                        class="m-mast-input"
                        change="changeSelect1"
                    >
                        <core:Item
                            key="Y"
                            text="Yes"
                        />
                        <core:Item
                            key="N"
                            text="No"
                        />
                    </ComboBox>

                    <Label
                        id="noofapprovallbl"
                        text="{i18n>noofapproval}"
                        class="m-mast-lev"
                    />
                    <Input
                        id="stagenoofapproval"
                        value="{EntryFormDataSourceModel>/NoOfApprovals}"
                        class="m-mast-input"
                        type="Number"
                        maxLength="1"
                    />

                    <Label
                        id="noofrejectionlbl"
                        text="{i18n>noofrejection}"
                        class="m-mast-lev"
                    />
                    <Input
                        id="stagenoofrejection"
                        value="{EntryFormDataSourceModel>/NoOfRejections}"
                        enabled="true"
                        class="m-mast-input"
                        type="Number"
                        maxLength="1"
                    />
                </f:content>
            </f:SimpleForm>
        </VBox>
        <VBox>
            <HBox
                class="sapUiSmallMarginEnd"
                justifyContent="End"
            >
                <VBox>
                    <Button
                        icon="sap-icon://add"
                        text="{i18n>addNew}"
                        press="addRow"
                    />
                </VBox>
            </HBox>
            <ScrollContainer
                width="100%"
                height="300px"
                horizontal="true"
                vertical="true"
            >
                <Table
                    id="smStageRoleTable"
                    items="{
                        path: 'EntryFormDataSourceModel>/Role'
                 }"
                    class="sapUiSizeCompact"
                    inset="true"
                    sticky="ColumnHeaders,HeaderToolbar"
                    showSeparators="All"
                    showNoData="true"
                >
                    <columns>
                        <Column>
                            <Label text="Sr No" />
                        </Column>
                        <Column>
                            <Label
                                text="Role"
                                labelFor="stageRole"
                            />
                        </Column>
                        <Column>
                            <Label
                                text="RoleType"
                                labelFor="RoleType"
                            />
                        </Column>
                        <Column />
                    </columns>
                    <items>
                        <ColumnListItem vAlign="Middle">
                            <cells>
                                <Text
                                    id="ustester_SrNo"
                                    text="{EntryFormDataSourceModel>RowNumber}"
                                />
                                <Input
                                    id="rolCode"
                                    type="Text"
                                    value="{EntryFormDataSourceModel>RoleCode}"
                                    placeholder="Select Stage ..."
                                    showValueHelp="true"
                                    valueHelpRequest="cflForRole"
                                    required="true"
                                />
                                <Input
                                    id="roletype"
                                    type="Text"
                                    value="{EntryFormDataSourceModel>RoleType}"
                                    placeholder="Select RoleType ..."
                                    showValueHelp="true"
                                    valueHelpRequest="cflForRoleType"
                                    required="true"
                                />

                                <Button
                                    icon="sap-icon://delete"
                                    press="onDeleteStage"
                                    type="Reject"
                                    visible="true"
                                    width="35px"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </ScrollContainer>
        </VBox>
        <footer>
            <Toolbar class="d-flex justify-content-center btn-sav">
                <ToolbarSpacer />
                <Button
                    type="Emphasized"
                    id="StageMaster_Button"
                    text="{i18n>submit}"
                    press="onSave"
                />
            </Toolbar>
        </footer>
    </Page>
</mvc:XMLView>
