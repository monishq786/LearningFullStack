<mvc:XMLView
    controllerName="modconfcontroller.enummasterentryform"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    class="d-flex justify-content-center">
    <Page
   
        id="enummasterf"
        title="{i18n>masterenumtitle}"
        showNavButton="true"
        navButtonPress="onPressOfEntryFormCancelButton"
    >
        <VBox>
            <f:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                columnsXL="1"
                columnsL="1"
                columnsM="1"
                singleContainerFullSize="false"
                labelSpanXL="3"
                labelSpanL="3"
                labelSpanM="3"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="4"
                emptySpanL="4"
                emptySpanM="4"
                emptySpanS="0"
            >
                <f:content>
                    <Label
                        id="enumcodelbl1"
                        text="{i18n>enumcode}"
                        required="true"
                    />
                     <Input
                        id="enumcod"
                        value="{EntryFormDataSourceModel>/EnumCode}"
                        required="true"
                        enabled="true"
                    /> 

                     <!-- <Input

                      
                            id="menucod1"
                            type="Text"
                            value="{EntryFormDataSourceModel>/MENUCODE}"
                            placeholder="Select Menu ..."
                            showValueHelp="true"
                            valueHelpRequest="cflForMenuCode"
                            required="true"
                            enabled="{EnableCheck>/EnableMenuCode}"
                           
                           
                        /> -->

                    <Label
                        id="enumdeslbl1"
                        text="{i18n>enumdesc}"
                        required="true"
                    />
                    <Input
                        id="menuname1"
                        value="{EntryFormDataSourceModel>/EnumDescription}"
                        required="true"
                        enabled="true"
                    />
                    <Label
                        id="enumtypelbl1"
                        text="{i18n>enumtype}"
                        required="true"
                    />

                    <Input
                        id="enumtyp"
                        value="{EntryFormDataSourceModel>/EnumType}"
                        required="true"
                        enabled="true"
                    />
 
                </f:content>
            </f:SimpleForm>
        </VBox>
        <footer>
         
            <Toolbar class="d-flex justify-content-center btn-sav">
                <ToolbarSpacer />
                 <Button type="Emphasized" id="EnumMaster_Button" text="{i18n>submit}" press="onSave"/>
                <!-- <Button id="EnumMaster_Button"
                    type="Emphasized"
                    text="{i18n>save}"
                    press="onSave"
                />  -->
              <Button type="Reject" text="{i18n>cancel}" press=".onCancel" class="can-btn" />
            </Toolbar>
        </footer>

        <!-- <Toolbar>
            <ToolbarSpacer />
            <Button
                text="{i18n>save}"
                press=".onSave"
            />
            <Button
                text="{i18n>cancel}"
                press=".onCancel"
            />
        </Toolbar> -->
    </Page>
</mvc:XMLView>
