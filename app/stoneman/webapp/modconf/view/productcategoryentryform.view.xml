<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:commons="sap.suite.ui.commons"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:u="sap.ui.unified"  displayBlock="true"
    xmlns="sap.uxap"
    xmlns:m="sap.m"
    xmlns:grid="sap.ui.layout.Grid"
    xmlns:layout="sap.ui.layout"
    controllerName="modconfcontroller.productcategoryentryform">
    <m:Page
        id="productcategoryref"
        title="{i18n>ProductCategoryEntryForm}"
        showNavButton="true"
        navButtonPress="onPressOfEntryFormCancelButton"
        >
        <ObjectPageLayout upperCaseAnchorBar="false">
            <sections>
                <ObjectPageSection titleUppercase="false" title="Product Category">
                    <ObjectPageSubSection title="User" titleUppercase="false">
                        <m:VBox id="productCategory" class="section">
                            <core:Fragment fragmentName="modconfigfragment.productcategoryfragment.Product" type="XML">
                            </core:Fragment>
                        </m:VBox>
                    </ObjectPageSubSection>
                </ObjectPageSection>
                

                <ObjectPageSection titleUppercase="false" title="CAD Level">
                    <ObjectPageSubSection title="CAD Level" titleUppercase="false">
                        <m:VBox id="buyerSection1" class="section">
                            <core:Fragment fragmentName="modconfigfragment.productcategoryfragment.Cadlevel" type="XML">
                            </core:Fragment>
                        </m:VBox>
                    </ObjectPageSubSection>
                </ObjectPageSection>

                

                
            </sections>
        </ObjectPageLayout>

        <m:footer >
            <m:Toolbar >
                <m:ToolbarSpacer />
                
                <m:Button type="Emphasized" id="ProductCategory_Button" text="{i18n>save}" press="onSave" />
                <m:Button type="Reject" text="{i18n>cancel}" press=".onCancel" class="can-btn" />
            </m:Toolbar>
        </m:footer>
    </m:Page>
</mvc:View>

















