<mvc:View
    xmlns:form="sap.ui.layout.form"
    controllerName="logincontroller.login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true"
    height="100%"
    xmlns:f="sap.f"
	xmlns:card="sap.f.cards"
>
	 <VBox alignContent="Center" alignItems="Center" justifyContent="Center" >
	<f:Card class="sapUiMediumMarginTop" width="100%"  >
		 
		<f:content>
			  <VBox
                    width="45vh"
                    height="85vh"
                    class="sapUiMediumMarginBeginEnd"
                >
                    <HBox
                        alignItems="Center"
                        justifyContent="Center"
                        class="sapUiMediumMarginTop"
                    >
                        <Image
                            src="../images/stonemenLogo.png"
                            id="imgLogoctrl"

                        />
                    </HBox>
                    <HBox
                        justifyContent="Center"
                        class="sapUiMediumMarginBottom sapUiMediumMarginTop"
                    >
                        <core:Icon
                            src="sap-icon://person-placeholder"
                            size="4rem"
                        />
                    </HBox>
                    <HBox>
                        <Title
                            text="Sign in"
                            class="sapUiSmallMarginBottom titleTexttitleText"
                            textAlign="Center"
                        />
                    </HBox>

                    <Input
                        id="usernameInput"
                        type="Email"
                        valueLiveUpdate="true"
                        value="{EntryFormDataSourceModel>/username}"
                        liveChange=".onUsernameChange"
                        placeholder="Username"
                        class="sapUiSmallMarginBottom"
                    />
                    <Input
                        id="passwordInput"
                        type="Password"
                        valueLiveUpdate="true"
                        value="{EntryFormDataSourceModel>/password}"
                        liveChange=".onPasswordChange"
                        placeholder="Password"
                        class="sapUiSmallMarginBottom"
                    />
                    <Link
                        text="Forgot password?"
                        textAlign="Center"
                        width="100%"
                    />

                    <VBox
                        height="100%"
                        justifyContent="End"
                        class="footer"
                    >
                        <FlexBox
                            justifyContent="End"
                            class="sapUiSmallMarginBottom"
                        >
                            <Button
                                text="Sign in"
                                press=".onPressLogin"
                                type="Emphasized"
                                width="auto"
                            />
                        </FlexBox>
                    </VBox>
                </VBox>
		</f:content>
	</f:Card>
     </VBox>
</mvc:View>
