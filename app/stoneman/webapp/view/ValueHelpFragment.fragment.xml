<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form" controllerName="stoneman.controller.ValueHelpFragment">


    <Dialog id="dynamicDialog" title="" class="sapMText.message center fontSize">
        <content>
            <!-- <HBox id="dynamicVBox"> -->
            <!-- Dynamic fields will be added here -->
            <!-- </HBox> -->
            <!-- 
       <Toolbar>
        <ToolbarSpacer />
        
        <ToolbarSpacer />
      </Toolbar> -->
            <!-- <HBox id="busyIndicatorWrapper" class="centerBusyIndicatorWrapper"> -->
            <VBox class="relativeContainer">
                <BusyIndicator id="busyIndicator" visible="false" class="absoluteCenter"/>
                <Table id="dynamicTable" mode="SingleSelectMaster" growing="true" growingThreshold="20" itemPress="onRowPress" items="{/d/results}" class="tablemargin1 customTableHeader" sticky="ColumnHeaders,HeaderToolbar">
                    <headerToolbar>
                        <Toolbar>
                            <SearchField id="idSearchField" width="100%" search="onSearchTable" class="margin-search" placeholder="Search...">
                            </SearchField>
                        </Toolbar>
                    </headerToolbar>

                    <columns>
                    </columns>

                    <items>
                        <ColumnListItem press="onRowPress">
                            <!-- Cells will be added dynamically -->
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
        <buttons>
            <Button text="Cancel" press=".onCloseDialog"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>