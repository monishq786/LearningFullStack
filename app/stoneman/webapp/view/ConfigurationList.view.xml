<mvc:XMLView xmlns:mvc="sap.ui.core.mvc"
   xmlns="sap.m"
   xmlns:core="sap.ui.core"
   xmlns:l="sap.ui.layout" controllerName="stoneman.controller.ConfigurationList" displayBlock="true">
   <App>
      <pages>
         <Page id="page" class="sapUiStdPage marginBoxContent sapUiContentPadding" title="{i18n>congifSearch}" showNavButton="true" navButtonPress=".navBack" enableScrolling="false">
            <headerContent>
               <Label text="{view>/myName}" class="lblText boldTxt" />
               <Button icon="sap-icon://log" press=".onPressLogout" />
            </headerContent>
            <content>
               <FlexBox id="myFlexBox" alignItems="Center" justifyContent="SpaceBetween" direction="Column">
                  <HBox width="100%" class="lPadding">
                     <VBox width="15%" class="sapUiTinyMargin">
                        <HBox width="100%" height="35px" class="sapUiTinyMarginTop">
                           <Text id="userNameLbl" text="{i18n>userName}" width="100%" class="sapUiSmallMarginEnd myCustomText" />
                        </HBox>
                      </VBox>
                     <VBox width="20%" class="sapUiTinyMargin">
                        <HBox width="100%">
                           <Input id="userName" type="Text" value="" placeholder="Select User Name" showValueHelp="true" valueHelpRequest="onValueHelpUserLookup" width="12rem" class="sapUiSmallMarginBottom"/>
                        </HBox>
                      </VBox>
                     <VBox width="10%" class="sapUiTinyMargin">
                        <HBox width="100%" height="35px" class="sapUiTinyMarginTop">
                           <Text id="deptLbl" text="{i18n>deptName}" class="sapUiTinyMarginEnd myCustomText" />
                        </HBox>
                     </VBox>
                     <VBox width="20%" class="sapUiTinyMargin">
                        <HBox width="100%" class="sapUiTinyMarginTop">
                          <Input id="dept" type="Text" value="" placeholder="Select Dept Name" showValueHelp="true" valueHelpRequest="onValueHelpDepartmentSearch" width="12rem" class="sapUiSmallMarginBottom marginTopLbl"/>
                        </HBox>
                    </VBox>
                     <VBox width="10%" class="sapUiTinyMargin">
                        <HBox width="100%" height="35px" class="sapUiTinyMarginTop">
                           <Text id="userRoleLbl" text="{i18n>userRoleCode}" class="sapUiSmallMarginEnd myCustomText" />
                        </HBox>
                     </VBox>
                     <VBox width="20%" class="sapUiTinyMargin">
                       <HBox width="100%"  class="sapUiTinyMarginTop">
                          <Input id="userRole" type="Text" value="" placeholder="Select User Role Code" showValueHelp="true" valueHelpRequest="onValueHelpRoleLookup" width="12rem" class="sapUiSmallMarginBottom marginTopLbl"/>
                        </HBox>
                     </VBox>
                  </HBox>
                  <HBox width="100%" height="10px" />
                  <HBox width="100%" class="lPadding">
                     <HBox width="50%">
                        <VBox width="22%" alignContent="Center">
                           <Button id="btnClear" text="{i18n>clearSearch}" type="Emphasized" class="sapUiTinyMarginBegin sapUiTinyMarginEnd" press="clearValue" />
                        </VBox>
                        <VBox width="15%" alignContent="Center">
                           <Button id="btnSearch" text="{i18n>search}" type="Emphasized" class="sapUiTinyMarginBegin" press="onSearch" />
                        </VBox>
                     </HBox>
                     <HBox width="50%">
                        <HBox width="70%" />
                        <HBox width="30%">
                           <VBox width="20%">
                              <Button id="addMarchant" text="{i18n>addConfig}" type="Emphasized" class="sapUiTinyMarginBegin" press="onRouterClick" icon="sap-icon://add" />
                           </VBox>
                        </HBox>
                     </HBox>
                  </HBox>
                  <HBox width="100%" height="20px" />
               </FlexBox>
               <VBox>
                  <ScrollContainer width="100%" horizontal="false" vertical="true" focusable="true" class="scroll-container-height">
                     <Table id="cadListTable" width="auto" growing="true" growingThreshold="10" items="{path:'configurationModel>/value'}" class="sapUiSizeCompact myCustomListClass textAlignCenter" inset="true" sticky="ColumnHeaders,HeaderToolbar" showSeparators="All" showNoData="true">
                        <columns>
                           <Column width="10%">
                              <Text text="{i18n>usercode}" />
                           </Column>
                           <Column width="10%">
                              <Text text="{i18n>username}" />
                           </Column>
                           <Column width="10%">
                              <Text text="{i18n>deptCode}" />
                           </Column>
                           <Column width="10%">
                              <Text text="{i18n>deptName}" />
                           </Column>
                           <Column width="10%">
                              <Text text="{i18n>userrolecode}" />
                           </Column>                          
                           <Column width="5%">
                              <Text text="{i18n>action}" />
                           </Column>
                        </columns>
                        <items>
                           <ColumnListItem vAlign="Middle">
                              <cells>
                                 <Text text="{configurationModel>Usercode}" wrapping="false" />
                                 <Text text="{configurationModel>Username}" wrapping="false" />
                                 <Text text="{configurationModel>DepartmentCode}" wrapping="false" />
                                 <Text  text="{configurationModel>DepartmentName}" wrapping="false" />
                                 <Text text="{configurationModel>UserRoleCode_RoleCode_RoleConstant}" wrapping="false" />
                                 
                                 <HBox>
                                    <items>
                                       <Button id="arrowBtn" icon="sap-icon://navigation-right-arrow" width="25px" class="customIconColor" visible="true" press="onAction" />
                                    </items>
                                 </HBox>
                              </cells>
                           </ColumnListItem>
                        </items>
                     </Table>
                    </ScrollContainer>
               </VBox>
            </content>
         </Page>
      </pages>
   </App>
</mvc:XMLView>