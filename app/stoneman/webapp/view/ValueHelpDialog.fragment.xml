<core:FragmentDefinition controllerName="productweb.controller.ValueHelpDialog"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">
    <Dialog id="helloDialog" title="{i18n>dialogTitle}" class="sapMText.message">
        <content>
            <VBox>
                <Text text="This is a dialog fragment."/>
            </VBox>
        </content>
        <buttons>
            <Button text="Close" press=".onCloseDialog"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>
