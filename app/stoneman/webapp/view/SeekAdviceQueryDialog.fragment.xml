<core:FragmentDefinition controllerName="stoneman.controller.SeekAdviceQueryDialog"
xmlns="sap.m" 
xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form"
 >
     <Dialog id="queryDialog" title="{i18n>dialogTitle}" class="sapMText.message boldTitle">
        <content>
        
         <Table
		items="{
			path: 'cadRequestModel>/tabledata2',
			sorter: {
				path: 'Name'
			}
		}"  class="tab-padding" id="myTable6">
		
		<columns>
			
			<Column width="30%">
				<Text text="Department" />
			</Column>
			<Column width="30%">
				<Text text="Role" />
			</Column>
      <Column width="30%">
				<Text text="User" />
			</Column>
			<Column width="40%">
				<Text text="Comments" />
			</Column>
      <Column width="20%">
				<Text text="Attachment" />
			</Column>
        
		</columns>
		<items>
			<ColumnListItem vAlign="Middle">
				<cells>
     
        <ComboBox id="deptDialog" width="180px" maxWidth="100%"
        valueState="None"  visible="true" editable="true"  selectedKey=""
        selectionChange=".onColorComboChange"
        items="{path:'cadRequestModel>/values'}"  class="labelHeight">
        <items>
          <core:Item 
          key="{cadRequestModel>name}"
          text="{cadRequestModel>value}" />
         
        </items>
        </ComboBox>
        <ComboBox id="roleDialog" width="180px" maxWidth="100%"
        valueState="None"  visible="true" editable="true"  selectedKey=""
        selectionChange=".onColorComboChange"
        items="{path:'cadRequestModel>/values'}"  class="labelHeight">
        <items>
          <core:Item 
          key="{cadRequestModel>name}"
          text="{cadRequestModel>value}" />
         
        </items>
        </ComboBox>
        <ComboBox id="userDialog" width="180px" maxWidth="100%"
        valueState="None"  visible="true" editable="true"  selectedKey=""
        selectionChange=".onColorComboChange"
        items="{path:'cadRequestModel>/values'}"  class="labelHeight">
        <items>
          <core:Item 
          key="{cadRequestModel>name}"
          text="{cadRequestModel>value}" />
         
        </items>
        </ComboBox>
         <TextArea id="commentsDialog" value="{Comments}" width="100%" rows="4"/>
         <Button icon="sap-icon://upload" id="uploadDialog" text="{i18n>upload}" type="Emphasized" class="btnstyle" press="onUploadPress" />
        
                        
                       
      
        
    
             
				</cells>
			</ColumnListItem>
		</items>
	</Table> 
        </content>
        <buttons>
            <Button text="Add" press=".onAddQueryDialog"/>
            <Button text="Close" press=".onCloseQueryDialog"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>