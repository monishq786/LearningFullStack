<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
 <Table items="{    path: 'copRequestModel_New>/ProcessHistory',    sorter: {     path: 'Name'    }   }" class="tab-padding" id="myTable4">
                  <columns>
                     <Column width="40%">
                        <Text text="Stage Name" />
                     </Column>
                     <Column width="40%">
                        <Text text="User Name" />
                     </Column>
                     <Column width="40%">
                        <Text text="Creation Date" />
                     </Column>
                     <Column width="40%">
                        <Text text="Approval Status" />
                     </Column>
                     <Column width="40%">
                        <Text text="Approved/Rejected By" />
                     </Column>
                     <Column width="40%">
                        <Text text="Remarks" />
                     </Column>
                  </columns>
                  <items>
                     <ColumnListItem vAlign="Middle">
                        <cells>
                           <Text text="{copRequestModel_New>StageName}" wrapping="false" />
                           <Text text="{copRequestModel_New>Username}" wrapping="false" />
                           <Text text="{copRequestModel_New>createdAt}" wrapping="false" />
                           <Text text="{copRequestModel_New>ApprovalStatus}" wrapping="false" />
                           <Text text="{copRequestModel_New>ApprovedRejected}" wrapping="false" />
                           <Text text="{copRequestModel_New>Remarks}" wrapping="false" />
                        </cells>
                     </ColumnListItem>
                  </items>
               </Table>
           
</core:FragmentDefinition>