<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
  <Table id="cadTables" items="{
			path: 'copRequestModel_New>/InspDraw',
			sorter: {
				path: 'SrNo'
			}
		}" class="tab-padding">
      <headerToolbar>
                    <Toolbar>
                       
                        <ToolbarSpacer />
                       <Button id="cop_addActualCostingBtn1" icon="sap-icon://add" text="{i18n>addNew}" press="addActualCostingRow" />
                       
                    </Toolbar>
                </headerToolbar>
                     <columns>
                        <Column width="10%">
                           <Text text="{i18n>srNo}" />
                        </Column>
                        <Column width="15%">
                           <Text text="{i18n>attachmentname}" />
                        </Column>
                        <!-- <Column width="15%">
                           <Text text="{i18n>inspRefNo}" />
                        </Column>  -->
                        <!-- <Column width="20%">
                           <Text text="{i18n>inspRefDoc}"/>
                        </Column>  -->
                         <Column width="14%">

                        </Column> 
                        <Column width="10%">
                           <Text text="{i18>cadDrawings}" />
                        </Column > 
                        <Column width="14%">

                        </Column> 
                        <Column width="12%">
                           <Text text="{i18>designtl/draftsman}" />
                        </Column > 
                         <Column width="10%">
                           <Text text="{i18>cadno}" />
                        </Column > 
                     </columns>
                     <items>
                        <ColumnListItem vAlign="Middle">
                           <Text id="cop_srNum" text="{copRequestModel_New>srNo}"/>
                           <Text id="cop_attachmentName" text="{copRequestModel_New>AttachmentName}" class="labelHeight lab-algn"/>
                            <Text id="cop_insprRefNo" text="{copRequestModel_New>InspRefNo}" class="labelHeight lab-algn" /> 
                            <Text id="cop_insprRefDoc" text="{copRequestModel_New>InspRefDocAbsId/DisplayName}" wrapping="true" /> 
                           <HBox class="align-text">
                              <Button id="cop_viewBtn" icon="sap-icon://show" class="customIconColor" press="onViewFile"/>
                              <Button id="cop_downloadBtn" icon="sap-icon://download" class="customIconColor" press="onDownloadFile"/>
                           </HBox>
                           <Text id="cop_caddrawings" text="{copRequestModel_New>DraftAttachmentAbsId/DisplayName}" wrapping="true" />
                           <HBox class="align-text">
                              <Button id="cop_cop_viewBtn1" icon="sap-icon://show" class="customIconColor" press="onViewFile"/>
                              <Button id="cop_downloadBtn1" icon="sap-icon://download" class="customIconColor" press="onDownloadFile"/>
                           </HBox>
                           <Text id="cop_design" text="{copRequestModel_New>DraftUserID/Username}" wrapping="true" />
                           <Text id="cop_cadno" text="{copRequestModel_New>cadNo}" wrapping="true" />
                        </ColumnListItem>
                     </items>
                  </Table>           
</core:FragmentDefinition>