<mvc:View controllerName="landingcontroller.landing"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:uxap="sap.uxap"
    xmlns:tnt="sap.tnt" height="100%">

    <!-- <Menu id="avatarMenu" items="{
            path: 'menuModel>/menuItems'
        }" itemSelected=".onMenuItemSelect">
        <MenuItem text="{menuModel>label}" />
    </Menu> -->

    <tnt:ToolPage id="toolPage" sideExpanded="{shellBarModel>/sideExpanded}">
        <tnt:header>
            <!-- <f:ShellBar id="shellBar" title="Stonemen Crafts" secondTitle="Welcome {userModel>/username}" showMenuButton="true" menuButtonPressed=".onMenuButtonPress" showNavButton="false" showCopilot="false" showNotifications="true" notificationsNumber="0" notificationsPressed="onNotificationsPress" showProductSwitcher="false" homeIcon="./resources/sap/ui/documentation/sdk/images/logo_sap.png">
                <f:profile>
                    <Avatar press="onAvatarPress" initials="true" />
                </f:profile>
            </f:ShellBar> -->
        </tnt:header>

        <tnt:sideContent>
            <tnt:SideNavigation id="sideNavigation" expanded="false">
                <tnt:item>
                    <tnt:NavigationList id="navigationList" width="100%" selectedKey="home" itemSelect=".onNavItemSelect" items="{navigationModel>/sections}">
                        <tnt:NavigationListItem text="{navigationModel>title}" icon="{navigationModel>icon}" key="{navigationModel>key}" items="{navigationModel>child}">
                            <tnt:items>
                                <tnt:NavigationListItem icon="{navigationModel>menuIcon}" text="{navigationModel>title}" key="{= 'tile-' + ${navigationModel>key} }" />
                            </tnt:items>
                        </tnt:NavigationListItem>
                    </tnt:NavigationList>
                </tnt:item>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <uxap:ObjectPageLayout showHeaderContent="false" sections="{navigationModel>/sections}" id="ObjectPageLayout" showTitleInHeaderContent="false" alwaysShowContentHeader="false" preserveHeaderStateOnScroll="false" headerContentPinnable="false" isChildPage="false" upperCaseAnchorBar="false">
                <!-- <uxap:headerTitle>
                    <uxap:ObjectPageDynamicHeaderTitle >
                        <uxap:heading >
                            <Title text="Stonemen" wrapping="true" />
                        </uxap:heading>
                    </uxap:ObjectPageDynamicHeaderTitle>
                </uxap:headerTitle> -->

                <uxap:sections>

                    <uxap:ObjectPageSection id="ObjectPageSection" titleUppercase="false" title="{navigationModel>title}">
                        <uxap:subSections>
                            <uxap:ObjectPageSubSection>
                                <uxap:blocks>
                                    <FlexBox wrap="Wrap"  items="{navigationModel>child}">
                                        <items>
                                            <CustomListItem class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
                                                <GenericTile header="{navigationModel>title}" press=".onTilePress">
                                                    <!-- <TileContent>
                                                        <core:Icon src="{navigationModel>menuIcon}" />
                                                    </TileContent> -->
                                                </GenericTile>
                                            </CustomListItem>
                                        </items>
                                    </FlexBox>

                                </uxap:blocks>
                            </uxap:ObjectPageSubSection>
                        </uxap:subSections>
                    </uxap:ObjectPageSection>

                </uxap:sections>
            </uxap:ObjectPageLayout>
        </tnt:mainContents>
    </tnt:ToolPage>
    <Dialog id="notificationDialog" title="Notifications" afterClose=".onDialogClose" stretch="true">
        <List items="{notificationModel>/notifications}">
            <items>
                <NotificationListItem title="{notificationModel>FormType} ({notificationModel>DocumentNo})" 
                datetime="{notificationModel>DateTime}" description="{notificationModel>NotificatoinMessage}"
                 unread="{= !${notificationModel>Read}}" press=".onNotificationPress" 
                 class="{= ${notificationModel>Read}==true ? 'readNotification' : 'unreadNotification' } notificationListItem" 
                 close=".onClearNotificationPress" />
            </items>
        </List>
        <buttons>
            <Button text="Read All" press=".onReadAllPress" visible="{= ${notificationModel>/notifications}.length > 0}" />
            <Button text="Clear All" press=".onClearAllPress" visible="{= ${notificationModel>/notifications}.length > 0}" />
            <Button text="Close" press=".onDialogClose" />
        </buttons>
    </Dialog>
</mvc:View>
